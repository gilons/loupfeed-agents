#!/usr/bin/env bash
# Render manifest.yml from manifest.template.yml for THIS publisher.
#
# Forge insists that every egress destination is declared in the manifest, so the
# deployment URL cannot be a pure runtime setting: each organisation renders and
# deploys its own copy. Everything else about the app is generic.
#
#   LOUPFEED_DEPLOYMENT_URL   required, e.g. https://agents.acme.dev
#   FORGE_APP_ID              optional; defaults to the id already in
#                             manifest.yml, so re-rendering never detaches an
#                             app from its registration
#
# Usage:  LOUPFEED_DEPLOYMENT_URL=https://agents.acme.dev bin/render-manifest
set -euo pipefail

cd "$(dirname "$0")/.."
TEMPLATE=manifest.template.yml
OUT=manifest.yml

if [ ! -r "$TEMPLATE" ]; then
  echo "error: $TEMPLATE not found" >&2
  exit 1
fi

URL="${LOUPFEED_DEPLOYMENT_URL:-}"
if [ -z "$URL" ]; then
  echo "error: set LOUPFEED_DEPLOYMENT_URL to your deployment's https origin" >&2
  echo "       e.g. LOUPFEED_DEPLOYMENT_URL=https://agents.acme.dev $0" >&2
  exit 2
fi
case "$URL" in
  https://*) ;;
  *) echo "error: LOUPFEED_DEPLOYMENT_URL must start with https:// (got '$URL')" >&2; exit 2 ;;
esac
# A trailing slash produces a double slash in the forwarded path.
URL="${URL%/}"

# Keep the existing registration unless the caller names another app.
APP_ID="${FORGE_APP_ID:-}"
if [ -z "$APP_ID" ] && [ -r "$OUT" ]; then
  APP_ID=$(awk '/^[[:space:]]+id:[[:space:]]*ari:cloud:ecosystem/ {print $2; exit}' "$OUT" || true)
fi

TMP=$(mktemp)
{
  echo "# GENERATED by bin/render-manifest from manifest.template.yml. Do not edit."
  echo "# Re-render after changing the template or your deployment URL."
  # Drop the template's own explanatory header: it documents the template, and
  # repeating it here would also mean substituting the placeholder inside prose.
  awk 'BEGIN{header=1} header && (/^#/ || /^[[:space:]]*$/) {next} {header=0} !header {print}' \
    "$TEMPLATE" |
    sed "s|\${LOUPFEED_DEPLOYMENT_URL}|$URL|g"
} > "$TMP"
if [ -n "$APP_ID" ]; then
  printf '  id: %s\n' "$APP_ID" >> "$TMP"
fi
mv "$TMP" "$OUT"

echo "rendered $OUT"
echo "  deployment: $URL"
if [ -n "$APP_ID" ]; then
  echo "  app id:     $APP_ID"
else
  echo "  app id:     none yet — run 'forge register' next, it writes one"
fi
